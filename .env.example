# Application service name
PROJECT_NAME=semcache

# Environment execution mode (development, staging, production, test)
ENVIRONMENT=development

# Logging verbosity level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable or disable debug mode
DEBUG=false

# Server listening bind host
HOST=0.0.0.0

# Server listening port
PORT=8000

# PostgreSQL database username
POSTGRES_USER=change-me

# PostgreSQL database password
POSTGRES_PASSWORD=change-me

# PostgreSQL database name
POSTGRES_DB=semcache_db

# PostgreSQL server hostname
POSTGRES_HOST=localhost

# PostgreSQL server port
POSTGRES_PORT=5432

# Async PostgreSQL connection string (overrides individual POSTGRES_* settings when provided)
DATABASE_URL=postgresql+asyncpg://change-me:change-me@localhost:5432/semcache_db

# Base URL of the Ollama server for LLM generation and embeddings
OLLAMA_BASE_URL=http://localhost:11434

# Timeout in seconds for Ollama LLM generation requests
OLLAMA_REQUEST_TIMEOUT=30.0

# Number of retries on transient Ollama request failures
OLLAMA_RETRY_COUNT=1

# Relative or absolute path to the YAML model tiers configuration
TIERS_CONFIG_PATH=config/tiers.yaml

# Name of the Ollama embedding model
EMBEDDING_MODEL=all-minilm

# Vector dimension matching the embedding model (e.g. 384 for all-minilm)
EMBEDDING_DIM=384

# Minimum cosine similarity threshold (0.0 to 1.0) required for a semantic cache hit
SIMILARITY_THRESHOLD=0.88

# Master toggle for exact SHA-256 key-value caching in Redis
EXACT_CACHE_ENABLED=true

# Master toggle for pgvector semantic vector caching
SEMANTIC_CACHE_ENABLED=true

# Restrict semantic caching to information-seeking questions only
SEMANTIC_INFO_ONLY=true

# Path to the YAML file defining conflicting antonym word pairs for the guard
ANTONYMS_CONFIG_PATH=config/antonyms.yaml

# Cache time-to-live duration in seconds for both exact and semantic cache records
CACHE_TTL_SECONDS=3600

# Cache version identifier included in exact and semantic keys to allow instant invalidation
CACHE_VERSION=v1

# Redis connection string for exact key-value caching
REDIS_URL=redis://localhost:6379/0

# Maximum cost budget in USD allowed per user query during tier routing
MAX_QUERY_BUDGET=0.05
